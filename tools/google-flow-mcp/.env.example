# Optional. Defaults to the platform application-data directory.
# FLOW_MCP_DATA_DIR=C:\Users\you\AppData\Local\flow-mcp

# Optional. Auto-detection prefers Chromium over Google Chrome.
# FLOW_MCP_BROWSER_EXECUTABLE=C:\Users\you\AppData\Local\Chromium\Application\chrome.exe

# Set to 1 only for diagnostics. Google sign-in and Flow are intended for headed mode.
# FLOW_MCP_HEADLESS=0
